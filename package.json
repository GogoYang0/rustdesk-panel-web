{
  "name": "rustdesk-panel-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "RustDesk Panel Web 控制台（React 19 + Vite + Semi Design + TailwindCSS v4）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:api": "openapi-typescript ../rustdesk-panel-api/openapi.yaml -o src/types/api-types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "e2e": "cypress run",
    "e2e:open": "cypress open"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "^2.0.0",
    "@douyinfe/semi-ui": "^2.0.0",
    "@tanstack/react-query": "^5.0.0",
    "echarts": "^6.0.0",
    "i18next": "^25.0.0",
    "openapi-fetch": "^0.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^16.0.0",
    "react-router": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cypress": "^15.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22"
  }
}
